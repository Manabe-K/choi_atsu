<div id="events_list" class="space-y-4">
  <% if events.any? %>
    <% events.each do |event| %>
      <% status = event_status(event) %>
      <% status_class = event_status_class(status) %>
      <% is_joined = user_joined?(event, current_user) %>
      <% card_classes =
        case status
        when "開催済み"
          "bg-gray-400"
        when "満員", "締切終了"
          "bg-gray-200"
        else
          "bg-white"
        end
      %>

      <div id="<%= dom_id(event, :card) %>"
           class="event-card relative flex items-stretch <%= card_classes %> rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300 cursor-pointer"
           data-url="<%= event_path(event, return_to: request.fullpath) %>">

        <!-- 左：アイコン -->
        <div class="flex-shrink-0 p-4 flex flex-col items-center justify-center">
          <% if event.host_user == current_user %>
            <% path = request.referer&.include?("/events/") ? mypage_path(return_to: request.fullpath) : mypage_path %>
            <%= link_to path, class: "hover:opacity-80 transition text-center block" do %>
              <%= image_tag event.host_user.profile_picture_url, alt: event.host_user.name, class: "w-16 h-16 rounded-full border border-gray-300 mx-auto" %>
              <p class="text-xs text-gray-600 mt-1">マイページ</p>
            <% end %>
          <% else %>
            <%= link_to user_path(event.host_user, return_to: request.fullpath),
                        class: "hover:opacity-80 transition text-center block" do %>
              <%= image_tag event.host_user.profile_picture_url, alt: event.host_user.name, class: "w-16 h-16 rounded-full border border-gray-300 mx-auto" %>
              <p class="text-xs text-gray-600 mt-1"><%= event.host_user.name %></p>
            <% end %>
          <% end %>

          <p class="text-xs font-semibold text-white text-center mt-2 px-2 py-1 rounded <%= status_class %>">
            <%= status %>
          </p>
        </div>

        <!-- 中央：イベント詳細 + タグ -->
        <div class="flex flex-col justify-between flex-1 p-4">
          <div class="flex items-center justify-between min-h-[32px]">
            <h2 class="text-base font-semibold text-gray-900"><%= event.title %></h2>
          </div>

          <p class="text-sm text-gray-600">
            <i class="far fa-calendar-alt mr-1"></i>
            <%= event.start_time.strftime('%Y-%m-%d %H:%M') %> 〜 <%= event.end_time.strftime('%H:%M') %>
            &nbsp;|&nbsp;
            <i class="fas fa-map-marker-alt mr-1"></i><%= event.location %>
            &nbsp;|&nbsp;
            <%= participation_count(event) %>
          </p>

          <p class="text-xs text-gray-500 mt-1">
            <i class="fas fa-hourglass-half mr-1"></i><%= event.deadline&.strftime('%Y-%m-%d') %>まで
          </p>

          <% if event.tags.any? %>
            <div class="flex flex-wrap gap-1 mt-2">
              <% event.tags.each do |tag| %>
                <%= link_to events_path(tag: tag.name),
                            class: "inline-flex items-center text-xs px-2 py-1 rounded-full text-white hover:opacity-80",
                            style: "background-color: ##{tag_color(tag.name)}" do %>
                  <i class="fas fa-tag mr-1 text-[10px]"></i><%= tag.name %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- 右：アクション -->
        <% unless event.host_user == current_user %>
          <div class="flex flex-col justify-center gap-2 p-4 w-50 text-center min-h-[4.5rem]">
            <% if status == "開催済み" %>
              <% message =
                if event.host_user == current_user
                  "幹事お疲れ様！\nまた企画してね"
                elsif is_joined
                  "ご参加ありがと！\nまた、集まりましょ"
                else
                  "ぜひ！また今度！\n集まりましょ"
                end
              %>
              <p class="whitespace-pre-line text-base font-bold text-white text-center leading-tight"><%= message %></p>
            <% else %>
              <% if %w[満員 締切終了].include?(status) && !is_joined %>
                <%= link_to event_path(event, return_to: request.fullpath),
                            class: "block w-full text-white font-bold py-2 rounded bg-gray-600 text-m text-center transition" do %>
                  <%= status %>
                <% end %>
              <% else %>
                <% if defined?(show_participation_button) ? show_participation_button : true %>
                  <%= participation_button(event, current_user) %>
                <% end %>
              <% end %>
              <% if defined?(show_curious_button) ? show_curious_button : true %>
                <%= curious_button(event, current_user) %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="text-center text-lg text-gray-600"><%= empty_message %></p>
  <% end %>
</div>