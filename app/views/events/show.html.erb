<% content_for :title, "#{@event.title} | ちょいあつ" %>
<% content_for :title, @event.title %>

<div class="container mx-auto max-w-screen-lg px-4 pt-8">
  <!-- 上部ナビゲーション -->
  <div class="flex justify-between items-center mb-6">
    <%= link_to t("buttons.back"), safe_return_to_path,
                class: "bg-gray-600 hover:bg-gray-500 text-white font-semibold py-2 px-5 rounded-lg shadow-md transition duration-300" %>

    <% if @event.host_user == current_user %>
      <% if @event.end_time.blank? || @event.end_time > 30.minutes.ago %>
        <div class="flex gap-3">
          <%= link_to t('buttons.edit'), edit_event_path(@event, return_to: request.fullpath),
                      class: "bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 px-5 rounded-lg shadow-md transition duration-300" %>
          <%= button_to t('buttons.delete'), @event,
                        method: :delete,
                        data: { confirm: t('events.confirm_delete') },
                        class: "bg-red-600 hover:bg-red-500 text-white font-semibold py-2 px-5 rounded-lg shadow-md transition duration-300" %>
        </div>
      <% else %>
        <div class="text-sm text-gray-500 font-semibold italic">
          ※ このイベントは終了から30分以上経過しました。
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- イベントカード -->
  <%= turbo_frame_tag "show_#{dom_id(@event, :card)}" do %>
    <%= render partial: "events/show_card", locals: { event: @event, current_user: current_user } %>
  <% end %>

  <!-- 参加者セクション -->
  <%= turbo_frame_tag "show_#{dom_id(@event, :participants)}" do %>
    <%= render partial: "events/participants", locals: { event: @event } %>
  <% end %>

  <!-- スレッドセクション -->
  <h2 class="text-xl font-semibold mb-4">スレッド</h2>
  <%= turbo_frame_tag "thread_section_#{@event.id}" do %>
    <%= render partial: "events/thread_section", locals: { event: @event, current_user: current_user } %>
  <% end %>
</div>
