<% content_for :title, "オフ会一覧" %>

<div class="container mx-auto px-4 py-8">
  <!-- ヘッダー -->
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold"><%= t('application.index') %></h1>
    <%= link_to t('application.new'), new_event_path, class: "bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 px-5 rounded-lg shadow-md transition duration-300" %>
  </div>

  <!-- イベント一覧 -->
  <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
    <% if @events.any? %>
      <% @events.each do |event| %>
        <div class="bg-white shadow-md rounded-lg overflow-hidden hover:shadow-xl transition duration-300">
          <%= link_to event_path(event) do %>
            <div class="p-6">
              <!-- イベントタイトル -->
              <h2 class="text-2xl font-semibold text-gray-900 mb-3"><%= event.title %></h2>

              <!-- タグ -->
              <% if event.tags.any? %>
                <div class="flex flex-wrap gap-2 mb-4">
                  <% event.tags.each do |tag| %>
                    <%= link_to "<i class='fas fa-tag'></i> #{tag.name}".html_safe, events_path(tag: tag.name), class: "text-sm px-3 py-1 bg-gray-200 rounded-full text-gray-700 hover:bg-gray-300" %>
                  <% end %>
                </div>
              <% end %>

              <!-- 日時・場所 -->
              <div class="text-sm text-gray-600 mb-4">
                <p><i class="far fa-calendar-alt"></i> <%= event.start_time.strftime('%Y-%m-%d %H:%M') %></p>
                <p><i class="fas fa-map-marker-alt"></i> <%= event.location %></p>
              </div>

              <!-- 期限・参加人数 -->
              <div class="flex justify-between text-sm text-gray-600">
                <p><i class="fas fa-hourglass-half"></i> <%= event.deadline.strftime('%Y-%m-%d') if event.deadline.present? %></p>
                <p><i class="fas fa-users"></i> 2名参加 / <%= event.capacity %>名</p>
              </div>
            </div>
          <% end %>

          <!-- 参加する・気になるボタン -->
          <div class="p-4 bg-gray-100 text-center">
            <%= button_to ("<i class='fas fa-user-plus'></i> " + t('buttons.join')).html_safe, "#", method: :post, class: "w-full bg-green-600 hover:bg-green-500 text-white font-semibold py-2 rounded-lg shadow-md transition duration-300" %>
            <%= button_to ("<i class='fas fa-heart'></i> " + t('buttons.interested')).html_safe, "#", method: :post, class: "w-full bg-yellow-500 hover:bg-yellow-400 text-white font-semibold py-2 rounded-lg shadow-md transition duration-300 mt-2" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center text-lg text-gray-600"><%= t('index.no_event') %></p>
    <% end %>
  </div>
</div>
