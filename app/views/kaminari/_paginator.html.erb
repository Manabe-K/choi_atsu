<% safe_params = params.permit(:sort, :tag, interested: [], available: []) %>

<nav class="flex justify-center mt-6">
  <ul class="inline-flex space-x-2 text-sm">
    <% if paginated.prev_page %>
      <li>
        <%= link_to "← 前へ", url_for(safe_params.merge(param_key => paginated.prev_page)),
                    class: "px-3 py-2 rounded-lg bg-gray-200 hover:bg-gray-300" %>
      </li>
    <% end %>

    <% paginated.total_pages.times do |i| %>
      <% page = i + 1 %>
      <li>
        <%= link_to page, url_for(safe_params.merge(param_key => page)),
                    class: "px-3 py-2 rounded-lg #{page == paginated.current_page ? 'bg-blue-500 text-white' : 'bg-gray-100 hover:bg-gray-200'}" %>
      </li>
    <% end %>

    <% if paginated.next_page %>
      <li>
        <%= link_to "次へ →", url_for(safe_params.merge(param_key => paginated.next_page)),
                    class: "px-3 py-2 rounded-lg bg-gray-200 hover:bg-gray-300" %>
      </li>
    <% end %>
  </ul>
</nav>