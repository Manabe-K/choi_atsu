<% content_for :title, t("tags.users.title") + " | ちょいあつ" %>
<div class="container mx-auto px-4 py-8">
  <!-- 中央揃えタイトル -->
  <h1 class="text-2xl font-bold text-center mb-6">
    <%= t("tags.users.heading", tag: @tag.name, count: @users.count) %>
  </h1>

  <!-- タグ名のイベント一覧へのボタンリンク -->
  <div class="flex justify-center mb-8">
    <%= link_to t("tags.users.to_events", tag: @tag.name),
                events_path(tag: @tag.name, interested: 1, available: 1),
                class: "bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold px-5 py-2 rounded-lg shadow transition" %>
  </div>

  <% if @users.any? %>
    <div class="flex flex-col space-y-2">
      <% @users.each do |user| %>
        <%= render partial: "shared/user_profile", locals: { user: user } %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-center"><%= t("tags.users.empty") %></p>
  <% end %>
</div>