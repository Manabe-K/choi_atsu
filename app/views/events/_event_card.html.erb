<div id="events_list" class="space-y-4">
  <% if events.any? %>
    <% events.each do |event| %>
      <% is_full = event_full?(event) %>
      <% is_joined = user_joined?(event, current_user) %>
      <% card_classes = is_full ? "bg-gray-200" : "bg-white" %>

      <div id="<%= dom_id(event, :card) %>" class="relative flex items-center <%= card_classes %> rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300">

        <!-- アイコン -->
        <div class="flex-shrink-0 p-4">
          <%= image_tag event.host_user.profile_picture, alt: event.host_user.name, class: "w-16 h-16 rounded-full border border-gray-300" %>
          <p class="text-xs text-center text-gray-600 mt-1"><%= event.host_user.name %></p>
        </div>

        <!-- イベント詳細 -->
        <%= link_to event_path(event, return_to: request.fullpath), class: "flex-1 p-4 relative" do %>
          <div class="flex items-center justify-between">
            <h2 class="text-base font-semibold text-gray-900"><%= event.title %></h2>
            <% if is_full %>
              <span class="ml-2 px-2 py-1 text-s font-semibold text-white bg-red-500 rounded">募集終了</span>
            <% end %>
          </div>

          <% if event.tags.any? %>
            <div class="flex flex-wrap gap-1 mt-1 mb-2">
              <% event.tags.each do |tag| %>
                <span class="text-xs px-2 py-1 rounded-full text-white" style="background-color: #<%= tag_color(tag.name) %>">
                  #<%= tag.name %>
                </span>
              <% end %>
            </div>
          <% end %>

          <p class="text-sm text-gray-600">
            <i class="far fa-calendar-alt mr-1"></i>
            <%= event.start_time.strftime('%Y-%m-%d %H:%M') %> 〜 <%= event.end_time.strftime('%H:%M') %>
            &nbsp;|&nbsp;
            <i class="fas fa-map-marker-alt mr-1"></i><%= event.location %>
            &nbsp;|&nbsp;
            <%= participation_count(event) %>
          </p>

          <p class="text-xs text-gray-500 mt-1">
            <i class="fas fa-hourglass-half mr-1"></i><%= event.deadline&.strftime('%Y-%m-%d') %>
          </p>
        <% end %>

        <!-- アクションボタン -->
        <% unless event.host_user == current_user %>
          <div class="flex flex-col justify-center gap-2 p-4 w-50 text-center">

            <%# 参加ボタンの切り替え %>
            <% if is_full && !is_joined %>
              <%= link_to event_path(event, return_to: request.fullpath),
                          class: "block w-full text-white font-bold py-2 rounded bg-gray-600 text-m text-center transition" do %>
                参加受付終了
              <% end %>
            <% else %>
              <% if defined?(show_participation_button) ? show_participation_button : true %>
                <%= participation_button(event, current_user) %>
              <% end %>
            <% end %>

            <% if defined?(show_curious_button) ? show_curious_button : true %>
              <%= curious_button(event, current_user) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="text-center text-lg text-gray-600"><%= empty_message %></p>
  <% end %>
</div>