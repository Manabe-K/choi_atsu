<%= form_with(model: @event, local: true, class: "max-w-3xl mx-auto p-6 bg-white rounded-xl shadow-md space-y-10") do |form| %>
  <% if @event.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded">
      <h2 class="font-bold mb-2">
        <%= pluralize(@event.errors.count, "件のエラー") %>があります
      </h2>
      <ul class="list-disc pl-5 text-sm">
        <% @event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- タイトル -->
  <div data-controller="form-animation" class="flex items-start gap-6 relative">
    <label class="w-40 text-sm font-semibold text-gray-700 pt-3">
      <i class="fas fa-heading mr-2 text-gray-500"></i>どんなイベント？
    </label>
    <div class="relative flex-1">
      <%= form.text_field :title, placeholder: "例：もくもく会 in 渋谷",
          class: "w-full border rounded-lg p-3 pr-10 transition-all duration-300",
          data: {
            form_animation_target: "input",
            action: "focus->form-animation#handleFocus blur->form-animation#handleBlur input->form-animation#handleInput change->form-animation#handleInput"
          } %>
    </div>
  </div>

  <!-- 開催日時 -->
  <div data-controller="form-animation" class="flex items-start gap-6 relative">
    <label class="w-40 text-sm font-semibold text-gray-700 pt-3">
      <i class="fas fa-calendar-alt mr-2 text-gray-500"></i>開催する時間は？
    </label>
    <div class="flex items-center gap-3 flex-1">
      <%= form.text_field :start_time, id: "event_start_time",
          placeholder: "開始時間をえらんでね",
          class: "w-full border rounded-lg p-3 pr-10 transition-all duration-300 datetime-picker",
          data: {
            form_animation_target: "input",
            action: "focus->form-animation#handleFocus blur->form-animation#handleBlur input->form-animation#handleInput change->form-animation#handleInput"
          } %>

      <span class="text-gray-500">〜</span>

      <%= form.text_field :end_time, id: "event_end_time",
          placeholder: "終了時間も忘れずに！",
          class: "w-full border rounded-lg p-3 pr-10 transition-all duration-300 datetime-picker",
          data: {
            form_animation_target: "input",
            action: "focus->form-animation#handleFocus blur->form-animation#handleBlur input->form-animation#handleInput change->form-animation#handleInput"
          } %>
    </div>
  </div>

  <!-- 開催場所 -->
  <div data-controller="form-animation" class="flex items-start gap-6 relative">
    <label class="w-40 text-sm font-semibold text-gray-700 pt-3">
      <i class="fas fa-map-marker-alt mr-2 text-gray-500"></i>どこでやる？
    </label>
    <div class="relative flex-1">
      <%= form.text_field :location, placeholder: "例：渋谷コワーキングスペース",
          class: "w-full border rounded-lg p-3 pr-10 transition-all duration-300",
          data: {
            form_animation_target: "input",
            action: "focus->form-animation#handleFocus blur->form-animation#handleBlur input->form-animation#handleInput change->form-animation#handleInput"
          } %>
    </div>
  </div>

  <!-- 参加情報 -->
  <div data-controller="form-capacity form-animation" class="flex items-start gap-6 relative">
    <label class="w-40 text-sm font-semibold text-gray-700 pt-3">
      <i class="fas fa-user-friends mr-2 text-gray-500"></i>参加情報
    </label>

    <div class="flex-1 flex flex-col gap-5">
      <p class="text-sm text-gray-700 font-medium">参加する人は決まってる？</p>

      <%= form.text_field :user_search, placeholder: "一緒に参加する人の名前を検索",
          class: "w-full border rounded-lg p-3 pr-10 text-sm transition-all duration-300",
          data: {
            form_animation_target: "input",
            action: "focus->form-animation#handleFocus blur->form-animation#handleBlur input->form-animation#handleInput change->form-animation#handleInput"
          } %>

      <div class="flex flex-wrap items-center gap-6 text-sm text-gray-700">
        <label class="flex items-center gap-2">
          <%= form.radio_button :no_limit, true, id: "event_no_limit",
                data: { action: "form-capacity#toggle" } %> 上限なしで募集する
        </label>

        <span class="text-gray-400">／</span>

        <label class="flex items-center gap-2">
          <%= form.radio_button :no_limit, false, id: "event_limit", checked: true,
                data: { action: "form-capacity#toggle" } %> 上限人数を決める：

          <div data-form-capacity-target="capacityField" class="w-37 transition-all duration-300">
            <%= form.number_field :capacity, placeholder: "例：5", min: 3,
                class: "w-full border rounded-lg p-2 text-right",
                data: {
                  form_capacity_target: "capacityInput",
                  form_animation_target: "input",
                  action: "focus->form-animation#handleFocus blur->form-animation#handleBlur input->form-animation#handleInput change->form-animation#handleInput"
                } %>
          </div>

          <!-- 上限なしが選ばれている時だけ見える「上限なし」表示＋ hidden -->
          <div data-form-capacity-target="capacityText" class="text-gray-500 hidden">
            上限なし
          </div>

          <%= form.hidden_field :capacity, value: 999,
              data: { form_capacity_target: "fallback" } %>

          <span class="text-gray-500">人</span>
        </label>
      </div>
    </div>
  </div>

  <!-- 詳細 -->
  <div data-controller="form-animation" class="flex items-start gap-6 relative">
    <label class="w-40 text-sm font-semibold text-gray-700 pt-3">
      <i class="fas fa-info-circle mr-2 text-gray-500"></i>もう少し詳しく教えて！
    </label>
    <div class="relative flex-1">
      <%= form.text_area :description, rows: 5,
          placeholder: "イベントの目的や対象者など、自由に書いてね",
          class: "w-full border rounded-lg p-3 pr-10 transition-all duration-300",
          data: {
            form_animation_target: "input",
            action: "focus->form-animation#handleFocus blur->form-animation#handleBlur input->form-animation#handleInput change->form-animation#handleInput"
          } %>
    </div>
  </div>

  <!-- 締切日時 -->
  <div data-controller="form-animation" class="flex items-start gap-6 relative">
    <label class="w-40 text-sm font-semibold text-gray-700 pt-3">
      <i class="fas fa-calendar-times mr-2 text-gray-500"></i>いつまで申し込める？
    </label>
    <div class="relative flex-1">
      <%= form.text_field :deadline, id: "event_deadline",
          placeholder: "締切日時を選んでね",
          class: "w-full border rounded-lg p-3 pr-10 transition-all duration-300 datetime-picker",
          data: {
            form_animation_target: "input",
            action: "focus->form-animation#handleFocus blur->form-animation#handleBlur input->form-animation#handleInput change->form-animation#handleInput"
          } %>
    </div>
  </div>

  <!-- 送信 -->
  <div class="mt-10 text-center">
    <%= form.submit(@event.persisted? ? "この内容に変更する" : "この内容で企画する！",
      class: "bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-full shadow transition duration-200") %>
  </div>
<% end %>