<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">イベント一覧</h1>

    <%= link_to "イベントを企画する",
                new_event_path,
                class: "bg-orange-500 hover:bg-orange-600 text-white font-semibold px-5 py-2.5 rounded-lg shadow transition duration-200" %>
  </div>

  <%= render partial: "event_card", locals: {
        events: @events,
        current_user: current_user,
        hide_buttons: false,
        empty_message: "現在、イベントはありません"
      } %>
</div>