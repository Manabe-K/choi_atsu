<turbo-frame id="thread_post_<%= thread_post.id %>">
  <div
    class="text-[12px] my-2 px-2"
    data-controller="chat-style"
    data-chat-style-user-id-value="<%= thread_post.user_id %>"
  >
    <div class="chat text-[12px] <%= 'chat-start' %>" data-chat-style-target="wrapper">
      <!-- アイコン -->
      <div class="chat-image avatar">
        <div class="w-8 rounded-full">
          <%= image_tag(
            thread_post.user.profile_picture_url,
            alt: "#{thread_post.user.name}のプロフィール画像",
            class: 'object-cover w-full h-full'
          ) %>
        </div>
      </div>

      <!-- 名前 -->
      <div class="chat-header text-[8px] text-gray-500 mb-1">
        <%= thread_post.user.name %>
      </div>

      <!-- 本文＋時間を横並び -->
      <div class="flex items-end gap-1 max-w-full">
        <!-- 時間（左） -->
        <div class="text-[8px] text-gray-400" data-chat-style-target="timeLeft">
          <%= l(thread_post.created_at, format: :short) %>
        </div>

        <!-- 吹き出し -->
        <div
          class="chat-bubble max-w-xs break-words bg-gray-100 text-gray-800"
          data-chat-style-target="bubble"
        >
          <%= simple_format(
            h(thread_post.content).gsub(%r{(https?://[^\s<]+)}i) do |url|
              "<a href='#{url}' onclick='window.open(this.href, \"_blank\"); return false;' class='text-blue-600 underline break-words'>#{url}</a>"
            end.html_safe
          ) %>
        </div>

        <!-- 時間（右） -->
        <div class="text-[8px] text-gray-400" data-chat-style-target="timeRight">
          <%= l(thread_post.created_at, format: :short) %>
        </div>
      </div>
    </div>
  </div>
</turbo-frame>