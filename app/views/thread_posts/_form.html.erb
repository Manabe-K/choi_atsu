<!-- app/views/thread_posts/_form.html.erb -->

<% if thread_post.new_record? %>
  <div id="new_thread_post" class="relative z-0 flex flex-col md:flex-row items-stretch bg-white rounded-lg shadow-md overflow-hidden transition duration-300 mb-6">
    <div class="p-6 w-full">
      <%= form_with model: [event, thread_post], local: false do |f| %>
        <div class="flex items-start gap-4">
          <%= f.text_area :content, placeholder: "内容を入力...", class: "w-full border rounded p-2" %>
          <%= f.submit "投稿", class: "bg-teal-600 text-white px-4 py-2 rounded" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>