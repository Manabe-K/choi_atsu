<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-2">
    「<%= @tag.name %>」を登録している<%= @users.count %>人
  </h1>

  <!-- タグ名のイベント一覧へのリンク -->
  <div class="mb-6">
    <%= link_to "「#{@tag.name}」のイベント一覧を見る →", events_path(tag: @tag.name, interested: 1, available: 1),
                class: "text-blue-600 hover:underline text-sm font-semibold" %>
  </div>

  <% if @users.any? %>
    <div class="flex flex-col space-y-2">
      <% @users.each do |user| %>
        <%= render partial: "shared/user_profile", locals: { user: user } %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">このタグを登録しているユーザーはいません。</p>
  <% end %>
</div>