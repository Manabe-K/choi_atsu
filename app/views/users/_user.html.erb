<div id="<%= dom_id user %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= user.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Github UID:</strong>
    <%= user.github_uid %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Profile picture:</strong>
    <%= image_tag(user.profile_picture, alt: 'Profile Picture', class: 'w-16 h-16 rounded-full object-cover') if user.profile_picture.present? %>
  </div>
</div>