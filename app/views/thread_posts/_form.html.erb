<!-- app/views/thread_posts/_form.html.erb -->

<% if thread_post.new_record? %>
  <div id="new_thread_post" class="p-4 bg-white rounded-xl shadow mb-6">
    <%= form_with model: [event, thread_post], local: false do |f| %>
      <div class="flex items-end gap-2">
<%= f.text_area :content,
                placeholder: "メッセージを入力...",
                rows: 2,
                required: true,
                class: "textarea textarea-bordered w-full bg-base-100 resize-none focus:outline-none focus:ring-1 focus:ring-teal-700 focus:border-teal-700",
                oninput: "this.setCustomValidity(this.value.trim() === '' ? '空白だけの投稿はできません' : '')" %>

        <%= f.submit "送信", class: "btn btn-neutral" %>
      </div>
    <% end %>
  </div>
<% end %>