<% content_for :title, @event.title %>

<% status = event_status(@event) %>
<% status_class = event_status_class(status) %>
<% is_joined = user_joined?(@event, current_user) %>
<% card_classes =
  case status
  when "開催済み"
    "bg-gray-400"
  when "満員", "締切終了"
    "bg-gray-200"
  else
    "bg-white"
  end
%>

<!-- 上部：編集・削除・戻る -->
<div class="container mx-auto px-4 pt-8 flex justify-between items-center">
  <% if @event.host_user == current_user %>
    <div class="flex gap-3">
      <%= link_to t('buttons.edit'),
                  edit_event_path(@event, return_to: request.fullpath),
                  class: "bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 px-5 rounded-lg shadow-md transition duration-300" %>

      <%= button_to t('buttons.delete'),
                    @event,
                    method: :delete,
                    data: { confirm: t('events.confirm_delete') },
                    class: "bg-red-600 hover:bg-red-500 text-white font-semibold py-2 px-5 rounded-lg shadow-md transition duration-300" %>
    </div>
  <% end %>

  <%= link_to t("buttons.back"),
              safe_return_to_path,
              class: "bg-gray-600 hover:bg-gray-500 text-white font-semibold py-2 px-5 rounded-lg shadow-md transition duration-300" %>
</div>

<!-- イベント詳細カード -->
<div class="container mx-auto px-4 py-4">
  <div id="<%= dom_id(@event, :card) %>" class="relative <%= card_classes %> rounded-xl border border-gray-300 shadow-lg overflow-hidden">

    <div class="p-6 relative">

      <!-- 右上：アクションボタン or メッセージ -->
      <% unless @event.host_user == current_user %>
        <div id="<%= dom_id(@event, :actions) %>" class="absolute top-4 right-4 flex flex-col justify-center text-center gap-2 p-4 w-50 min-h-[4.5rem] bg-white rounded-lg shadow z-10">
          <% if status == "開催済み" %>
            <p class="whitespace-pre-line text-base font-bold text-white bg-gray-700 px-3 py-1 rounded">
              <%= is_joined ? "ご参加ありがと！\nまた、集まりましょ" : "ぜひ！また今度！\n集まりましょ" %>
            </p>
          <% else %>
            <% if %w[満員 締切終了].include?(status) && !is_joined %>
              <%= link_to event_path(@event, return_to: request.fullpath),
                          class: "text-white font-bold py-2 px-4 rounded bg-gray-600 text-sm text-center transition whitespace-nowrap" do %>
                <%= status %>
              <% end %>
            <% else %>
              <%= participation_button(@event, current_user) %>
            <% end %>
            <%= curious_button(@event, current_user) %>
          <% end %>
        </div>
      <% end %>

      <!-- ステータスバッジ -->
      <div class="mb-2" id="<%= dom_id(@event, :status) %>">
        <span class="text-lg font-bold text-white px-4 py-1 rounded <%= status_class %>">
          <%= status %>
        </span>
      </div>

      <!-- タイトル -->
      <h1 class="text-3xl font-bold text-gray-900 mb-6"><%= @event.title %></h1>

      <!-- 開催情報 -->
      <div class="mb-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-2">開催情報</h2>
        <p class="text-base text-gray-700 mb-1">
          <i class="far fa-calendar-alt mr-1"></i>
          開催日時：<%= @event.start_time.strftime('%Y-%m-%d %H:%M') %> 〜 <%= @event.end_time.strftime('%H:%M') %>
        </p>
        <p class="text-base text-gray-700 mb-1">
          <i class="fas fa-map-marker-alt mr-1"></i>
          開催場所：<%= @event.location %>
        </p>
        <% if @event.deadline.present? %>
          <p class="text-base text-gray-700">
            <i class="fas fa-hourglass-half mr-1"></i>
            申込締切：<%= @event.deadline.strftime('%Y-%m-%d') %>まで
          </p>
        <% end %>
      </div>

      <!-- イベント詳細 -->
      <div class="mb-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-2">イベント詳細</h2>
        <p class="text-gray-700 whitespace-pre-line"><%= @event.description %></p>
      </div>

      <!-- タグ -->
      <% if @event.tags.any? %>
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-gray-800 mb-2">タグ</h2>
          <div class="flex flex-wrap gap-1 mt-1 mb-2">
            <% @event.tags.each do |tag| %>
              <%= link_to events_path(tag: tag.name),
                          class: "inline-flex items-center text-xs px-2 py-1 rounded-full text-white hover:opacity-80",
                          style: "background-color: ##{tag_color(tag.name)}" do %>
                <i class="fas fa-tag mr-1 text-[10px]"></i><%= tag.name %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>

<!-- 参加者表示（カードの外） -->
<div class="container mx-auto px-4 pb-8">
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-800 mb-2">参加者</h2>
    <div id="<%= dom_id(@event, :count) %>" class="text-base font-semibold text-gray-700 mb-3">
      <%= participation_count(@event) %> / <%= @event.capacity %> 名
    </div>
    <div class="flex flex-wrap gap-3">
      <% host = @event.host_user %>
      <div class="flex items-center gap-2 text-sm bg-pink-50 px-3 py-2 rounded-xl border border-pink-200 shadow-sm">
        <%= image_tag host.profile_picture, class: "w-10 h-10 rounded-full border border-pink-300" if host.profile_picture.present? %>
        <span class="font-semibold text-pink-800"><%= host.name %>（主催）</span>
      </div>
      <% @event.participant_users.where.not(id: host.id).limit(6).each do |user| %>
        <div class="flex items-center gap-2 text-sm bg-white px-3 py-2 rounded-xl border border-gray-300 shadow-sm">
          <%= image_tag user.profile_picture, class: "w-8 h-8 rounded-full border" if user.profile_picture.present? %>
          <%= user.name %>
        </div>
      <% end %>
      <% remaining = @event.participant_users.count - 6 %>
      <% if remaining > 0 %>
        <span class="text-sm text-gray-600">他 <%= remaining %> 人</span>
      <% end %>
    </div>
  </div>
</div>