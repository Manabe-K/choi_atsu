<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Myapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="flex">
    <%= render 'shared/header' %>

    <% unless controller.controller_name == 'static_pages' && controller.action_name == 'top' %>
      <!-- メニュー部分 -->
      <div class="w-64 bg-gray-800 text-white h-screen fixed top-0 left-0 p-6 pt-20 shadow-lg rounded-lg">
        <h2 class="text-2xl font-extrabold text-center text-indigo-400 mb-8"><%= t('application.menu') %></h2>
        <ul class="space-y-6">
          <li>
            <%= link_to events_path, class: "flex items-center space-x-3 text-gray-300 hover:text-white hover:bg-indigo-600 rounded-md p-2 transition-all duration-300" do %>
              <i class="fas fa-calendar-alt"></i>
              <span><%= t('application.index') %></span>
            <% end %>
          </li>
          <li>
            <%= link_to new_event_path, class: "flex items-center space-x-3 text-gray-300 hover:text-white hover:bg-indigo-600 rounded-md p-2 transition-all duration-300" do %>
              <i class="fas fa-plus-circle"></i>
              <span><%= t('application.new') %></span>
            <% end %>
          </li>
          <li>
            <%= link_to "#", class: "flex items-center space-x-3 text-gray-300 hover:text-white hover:bg-indigo-600 rounded-md p-2 transition-all duration-300" do %>
              <i class="fas fa-list-ul"></i>
              <span><%= t('application.plan&participation_list') %></span>
            <% end %>
          </li>
          <li>
            <%= link_to "#", class: "flex items-center space-x-3 text-gray-300 hover:text-white hover:bg-indigo-600 rounded-md p-2 transition-all duration-300" do %>
              <i class="fas fa-heart"></i>
              <span><%= t('application.interested_list') %></span>
            <% end %>
          </li>
          <li>
            <%= link_to "#", class: "flex items-center space-x-3 text-gray-300 hover:text-white hover:bg-indigo-600 rounded-md p-2 transition-all duration-300" do %>
              <i class="fas fa-user"></i>
              <span><%= t('application.my_page') %></span>
            <% end %>
          </li>
          <li>
            <%= link_to "#", class: "flex items-center space-x-3 text-gray-300 hover:text-white hover:bg-indigo-600 rounded-md p-2 transition-all duration-300" do %>
              <i class="fas fa-question-circle"></i>
              <span><%= t('application.how_to_use') %></span>
            <% end %>
          </li>
        </ul>
      </div>
    <% end %>

    <!-- メインコンテンツ -->
    <div class="flex-1 <%= 'ml-64' unless controller.controller_name == 'static_pages' && controller.action_name == 'top' %> pt-15 pb-24">
      <%= yield %>
    </div>

    <%= render 'shared/footer' %>
  </body>
</html>
