<%= form_with(model: @event, local: true, class: "max-w-3xl mx-auto p-6 bg-white rounded-lg shadow-md space-y-8") do |form| %>
  <% if @event.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 p-4 rounded">
      <h2 class="font-bold mb-2">
        <%= pluralize(@event.errors.count, "件のエラー") %>があります
      </h2>
      <ul class="list-disc pl-5 text-sm">
        <% @event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- タイトル -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-1">
      <i class="fas fa-heading mr-2 text-gray-500"></i>タイトル
    </label>
    <%= form.text_field :title, placeholder: "例：もくもく会 in 渋谷", class: "w-full border border-gray-300 rounded p-3" %>
  </div>

  <!-- 開催日時 -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-2">
      <i class="fas fa-calendar-alt mr-2 text-gray-500"></i>開催日時
    </label>
    <%= form.datetime_local_field :start_time,
        class: "w-full border border-gray-300 rounded p-3 bg-white",
        placeholder: "日付と時間を選択してください" %>

    <div class="mt-2">
      <%= form.datetime_local_field :end_time,
          class: "w-full border border-gray-300 rounded p-3 bg-white",
          placeholder: "終了日時を選択してください" %>
    </div>
  </div>


  <!-- 場所 -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-1">
      <i class="fas fa-map-marker-alt mr-2 text-gray-500"></i>開催場所
    </label>
    <%= form.text_field :location, placeholder: "例：渋谷コワーキングスペース", class: "w-full border border-gray-300 rounded p-3" %>
  </div>

  <!-- 人数 -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-1">
      <i class="fas fa-user-friends mr-2 text-gray-500"></i>参加上限人数
    </label>
    <%= form.number_field :capacity, placeholder: "上限がある場合のみ", class: "w-full border border-gray-300 rounded p-3" %>
  </div>

  <!-- 詳細 -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-1">
      <i class="fas fa-info-circle mr-2 text-gray-500"></i>イベントの詳細
    </label>
    <%= form.text_area :description, rows: 4, placeholder: "イベントの目的・対象者などをご記入ください", class: "w-full border border-gray-300 rounded p-3" %>
  </div>

  <!-- 締切日時 -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-2">
      <i class="fas fa-calendar-times mr-2 text-gray-500"></i>申込締切日時
    </label>
    <%= form.datetime_local_field :deadline,
        class: "w-full border border-gray-300 rounded p-3 bg-white",
        placeholder: "締切日時を選択してください" %>
  </div>

  <!-- 募集条件 -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-1">
      <i class="fas fa-filter mr-2 text-gray-500"></i>募集条件
    </label>
    <p class="text-sm text-gray-500">※ タグによる条件指定機能は現在準備中です</p>
  </div>

  <!-- フッター -->
  <div class="mt-6 text-center">
    <div class="text-base text-gray-600 font-semibold mb-3">
      <i class="fas fa-users mr-2 text-gray-500"></i>対象人数は ○○人です
    </div>

    <%= form.submit class: "bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-full shadow flex items-center justify-center gap-2" do %>
      <i class="far fa-clipboard"></i>
      <span>企画する</span>
    <% end %>
  </div>
<% end %>
