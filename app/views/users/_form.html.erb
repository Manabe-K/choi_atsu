<%= form_with(model: @user, class: "contents") do |form| %>
  <!-- 名前・画像など省略 -->

  <!-- タグ追加フォーム -->
  <div class="my-5">
    <%= label_tag :name, "タグを追加" %>
    <%= form_with url: user_tags_path, method: :post, local: true, class: "flex gap-2 mt-2" do %>
      <%= text_field_tag :name, nil, placeholder: "タグ名を入力", class: "flex-1 px-3 py-2 border rounded-md" %>
      <%= submit_tag "追加", class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-md" %>
    <% end %>
  </div>

  <!-- タグ一覧表示 -->
  <div class="my-5">
    <p class="mb-2 font-semibold">登録済みのタグ:</p>
    <div class="flex flex-wrap gap-2">
      <% current_user.tags.each do |tag| %>
        <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full inline-flex items-center">
          <span><%= tag.name %></span>
          <%= button_to "✕", user_tag_path(tag_id: tag.id), method: :delete, class: "ml-2 text-xs text-red-600" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>