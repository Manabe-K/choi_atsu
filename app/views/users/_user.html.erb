<div id="<%= dom_id user %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= user.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Uid:</strong>
    <%= user.uid %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Profile picture:</strong>
    <%= user.profile_picture %>
  </div>
</div>
