<% flash_config = {
  notice: {
    border_class: "border-green-400",
    icon_class: "fas fa-check-circle",
    icon_color: "text-green-500"
  },
  alert: {
    border_class: "border-red-400",
    icon_class: "fas fa-exclamation-triangle",
    icon_color: "text-red-500"
  }
} %>

<% if notice.present? || alert.present? %>
  <% type = notice.present? ? :notice : :alert %>
  <% config = flash_config[type] || { border_class: "border-gray-400", icon_class: "fas fa-info-circle", icon_color: "text-gray-500" } %>
  <% message = notice || alert %>

  <div id="flash_message"
       class="flash-message opacity-100 transition-opacity duration-500"
       data-controller="flash-message">
    <div class="inline-flex items-center gap-2 px-4 py-2 border-l-4 rounded-full shadow bg-white/90 backdrop-blur-sm <%= config[:border_class] %>">
      <i class="<%= config[:icon_class] %> <%= config[:icon_color] %> text-m"></i>
      <p class="text-sm text-gray-800 font-medium"><%= message %></p>
    </div>
  </div>
<% end %>