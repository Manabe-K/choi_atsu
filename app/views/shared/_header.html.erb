<header class="bg-gray-800 text-white py-4 fixed top-0 left-0 w-full z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center">
      <!-- 左側: アイコン -->
      <div class="flex items-center space-x-4">
        <span class="font-bold text-xl"><%= t('header.icon') %></span>
      </div>

      <!-- 右側: ログイン/ログアウト -->
<div class="text-sm space-x-4">
  <% if current_user %>
    <!-- プロフィール画像とドロップダウンメニュー -->
    <div class="relative inline-block">
      <!-- プロフィール画像 -->
      <button id="profile-button" class="w-8 h-8 rounded-full overflow-hidden">
        <%= image_tag(current_user.profile_picture, alt: 'Profile Picture', class: 'object-cover w-full h-full') %>
      </button>

      <!-- ドロップダウンメニュー -->
      <div id="dropdown-menu" class="hidden absolute right-0 mt-2 w-48 bg-white text-black rounded-lg shadow-lg">
        <ul>
          <li><%= link_to 'マイページ', mypage_path(clear_return_to: true), class: 'block px-4 py-2 text-sm' %></li>
          <li><%= link_to '設定', "#", class: 'block px-4 py-2 text-sm' %></li>
          <li><%= button_to 'ログアウト', logout_path, method: :delete, class: 'block px-4 py-2 text-sm text-red-500 hover:bg-gray-200' %></li>
        </ul>
      </div>
    </div>

  <% else %>
    <%= link_to t('header.login'), '/auth/github', class: "hover:underline" %>
  <% end %>
</div>
    </div>
  </div>
</header>