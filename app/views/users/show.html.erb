<% content_for :title, "#{@user.name}さん | "+ t("home.title") %>
<div class="flex items-center justify-between max-w-2xl mx-auto mt-10 mb-8 px-4">
  <button onclick="history.back()"
          class="bg-gray-600 hover:bg-gray-500 text-white font-semibold py-2 px-5 rounded-lg shadow-md transition duration-300">
    ← <%= t("buttons.back") %>
  </button>

  <h1 class="text-2xl font-bold text-gray-800 text-center flex-1">
    <%= t("users.profile_heading", name: @user.name) %>
  </h1>

  <div class="w-[100px]"></div>
</div>

<%= render partial: "shared/user_profile", locals: { user: @user, current_user: current_user } %>