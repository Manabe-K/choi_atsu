<!-- app/views/thread_posts/edit.turbo_stream.erb -->
<%= turbo_stream.replace "thread_post_#{@thread_post.id}" do %>
  <%= turbo_frame_tag "thread_post_#{@thread_post.id}" do %>
    <%= form_with(model: [@event, @thread_post], local: false) do |form| %>
      <div class="mb-2">
        <%= form.text_area :content, rows: 3, class: "w-full textarea textarea-bordered resize-none" %>
      </div>
      <div class="flex gap-2 justify-end">
        <%= form.button "更新", class: "btn btn-success btn-sm", data: { disable_with: "送信中…" } %>
        <%= link_to "キャンセル",
                    event_thread_post_path(@event, @thread_post, format: :turbo_stream),
                    data: {
                      turbo_frame: "thread_post_#{@thread_post.id}",
                      turbo_prefetch: false
                    },
                    class: "btn btn-outline btn-sm" %>
      </div>
    <% end %>
  <% end %>
<% end %>