<% content_for :title, "オフ会一覧" %>

<div> <!-- ヘッダーの高さ分の余白を追加 -->
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <!-- 「オフ会一覧」タイトルと「企画する」ボタン -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">オフ会一覧</h1>
    <%= link_to "企画する", new_event_path, class: "rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <!-- イベント一覧 -->
  <div id="events" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @events.any? %>
      <% @events.each do |event| %>
        <div class="bg-white shadow-md rounded-lg overflow-hidden cursor-pointer hover:bg-blue-50 transition-all duration-300">
          <%= link_to event_path(event), class: "block" do %>
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- 左側 -->
              <div>
                <h2 class="font-bold text-xl mb-2"><%= event.title %></h2>
                <p class="text-gray-700 mb-3">開始日時: <%= event.start_time.strftime('%Y-%m-%d %H:%M') %></p>
                <p class="text-gray-500 mb-2">場所: <%= event.location %></p>
              </div>

              <!-- 右側 -->
              <div class="flex flex-col items-end">
                <p class="text-sm text-red-600 mb-2">期限: <%= event.deadline.strftime('%Y-%m-%d') if event.deadline.present? %></p>
                <p class="text-sm text-gray-500 mb-2">
                  <%= "２名参加 / #{event.capacity}名" %>
                </p>
                <div class="flex space-x-2">
                  <%= button_to "参加", "#", method: :post, class: "rounded-md px-4 py-2.5 bg-green-600 hover:bg-green-500 text-white font-medium" %>
                  <%= button_to "気になる", "#", method: :post, class: "rounded-md px-4 py-2.5 bg-yellow-600 hover:bg-yellow-500 text-white font-medium" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10 text-lg">現在、イベントはありません。</p>
    <% end %>
  </div>
</div>
