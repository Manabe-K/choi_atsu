<% content_for :title, "ちょいあつ" %>
<div class="bg-gray-100 flex flex-col justify-start items-center min-h-screen px-4 pt-10 text-center">
  <!-- メインビジュアル -->
  <div class="mb-4">
    <div class="mb-2">
      <%= image_tag "welcome_text.png", alt: "ちょいとあつまりませんか？", class: "mx-auto w-full max-w-sm h-auto" %>
    </div>

    <p class="text-base text-gray-600 max-w-sm mx-auto leading-relaxed">
      友だちと、仲間と、ちょっとした集まりを。<br>
      GitHubでログインするだけで、イベントの企画も参加もすぐに始められます。
    </p>
  </div>

  <div class="mb-8">
    <%= image_tag "welcome_illustration.png", alt: "集まるイラスト", class: "w-64 h-auto mx-auto" %>
  </div>

  <div class="flex flex-col md:flex-row gap-3 justify-center items-center mb-8">
    <%= link_to "/auth/github", class: "bg-gray-900 text-white font-semibold px-4 py-2 rounded-lg hover:bg-gray-800 shadow transition flex items-center gap-2", data: { turbo: false } do %>
      <i class="fab fa-github text-lg"></i> GitHubでログイン
    <% end %>

    <%= link_to demo_login_path, class: "bg-white text-gray-700 border border-gray-300 font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 shadow transition flex items-center gap-2" do %>
      <i class="fas fa-flask text-lg text-teal-600"></i> デモモードで試す
    <% end %>
  </div>

  <div class="w-full max-w-md p-4 bg-white rounded-xl shadow-md text-left">
    <h2 class="text-lg font-semibold text-gray-800 mb-2">このサイトの使い方</h2>
    <ul class="list-disc list-inside text-gray-600 text-sm leading-relaxed">
      <li>GitHubアカウントでログイン</li>
      <li>イベントを企画・参加してつながる</li>
      <li>まずはデモモードで試してみるのもおすすめ</li>
    </ul>
  </div>
</div>

